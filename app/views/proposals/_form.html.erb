<%= form_with model: [ job, proposal ], class: "mt-6 space-y-5" do |form| %>
  <% if proposal.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
      <h3 class="font-semibold"><%= pluralize(proposal.errors.count, "error") %> prevented this proposal from being submitted:</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% proposal.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :amount, "Your amount", class: "block text-sm font-semibold text-slate-700" %>
    <%= form.number_field :amount, required: true, min: 0.01, step: 0.01, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
  </div>

  <div>
    <%= form.label :message, class: "block text-sm font-semibold text-slate-700" %>
    <%= form.text_area :message, required: true, rows: 7, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
  </div>

  <%= form.submit "Submit proposal", class: "w-full rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white hover:bg-indigo-500" %>
<% end %>
