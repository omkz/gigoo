<% content_for :title, "#{@job.title} · Gigoo" %>

<div class="grid w-full gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= link_to "← Browse jobs", jobs_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
    <% if @job.client.client_profile&.company_name.present? %>
      <p class="mt-8 text-sm font-medium text-slate-700"><%= @job.client.client_profile.company_name %></p>
      <p class="mt-1 text-sm text-slate-500">Posted by <%= @job.client.name %></p>
    <% else %>
      <p class="mt-8 text-sm text-slate-500">Posted by <%= @job.client.name %></p>
    <% end %>
    <h1 class="mt-2 text-3xl font-bold tracking-tight"><%= @job.title %></h1>

    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-y border-slate-200 py-5 text-sm">
      <div>
        <dt class="text-slate-500">Budget</dt>
        <dd class="mt-1 font-semibold"><%= number_to_currency(@job.budget) %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Location</dt>
        <dd class="mt-1 font-semibold"><%= @job.client.client_profile&.location.presence || "Not specified" %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Posted</dt>
        <dd class="mt-1 font-semibold"><%= l(@job.created_at.to_date, format: :long) %></dd>
      </div>
    </dl>

    <div class="mt-8 whitespace-pre-wrap leading-7 text-slate-700"><%= @job.description %></div>

    <% if @job.skills.any? %>
      <div class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Skills</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          <% @job.skills.each do |skill| %>
            <span class="rounded-md bg-indigo-50 px-3 py-1.5 text-sm text-indigo-700"><%= skill %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </article>

  <aside>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Submit a proposal</h2>

      <% if Current.user.nil? %>
        <p class="mt-3 text-slate-600">Sign in to apply for this job.</p>
        <%= link_to "Sign in to submit", new_session_path, class: "mt-5 inline-flex rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500" %>
      <% elsif Current.user.freelancer_profile.blank? %>
        <p class="mt-3 text-slate-600">Create a freelancer profile to submit a proposal.</p>
      <% elsif @job.client == Current.user %>
        <p class="mt-3 text-slate-600">You cannot submit a proposal to your own job.</p>
      <% elsif @existing_proposal %>
        <p class="mt-3 rounded-lg bg-emerald-50 px-4 py-3 font-medium text-emerald-800">Proposal submitted · <%= @existing_proposal.status.humanize %></p>
      <% else %>
        <%= render "proposals/form", job: @job, proposal: @proposal %>
      <% end %>
    </div>
  </aside>
</div>
