<% content_for :title, "Browse Jobs · Gigoo" %>

<section class="w-full">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Marketplace</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight">Browse open jobs</h1>
    <p class="mt-2 text-slate-600">Find work from clients looking for your skills.</p>
  </div>

  <% if @jobs.any? %>
    <div class="grid gap-5 lg:grid-cols-2">
      <% @jobs.each do |job| %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex h-full flex-col">
            <div class="flex items-start justify-between gap-4">
              <div>
                <% if job.client.client_profile&.company_name.present? %>
                  <p class="text-sm font-medium text-slate-700"><%= link_to job.client.client_profile.company_name, client_path(job.client.client_profile), class: "hover:text-indigo-600" %></p>
                <% end %>
                <p class="text-sm text-slate-500">
                  Posted by
                  <% if job.client.client_profile.present? %>
                    <%= link_to job.client.name, client_path(job.client.client_profile), class: "hover:text-indigo-600" %>
                  <% else %>
                    <%= job.client.name %>
                  <% end %>
                </p>
                <h2 class="mt-1 text-xl font-semibold"><%= link_to job.title, job_path(job), class: "hover:text-indigo-600" %></h2>
              </div>
              <p class="shrink-0 font-semibold text-slate-800"><%= number_to_currency(job.budget) %></p>
            </div>
            <p class="mt-4 text-slate-600"><%= truncate(strip_tags(job.description), length: 180) %></p>

            <% if job.skills.any? %>
              <div class="mt-5 flex flex-wrap gap-2">
                <% job.skills.each do |skill| %>
                  <span class="rounded-md bg-indigo-50 px-2.5 py-1 text-sm text-indigo-700"><%= skill %></span>
                <% end %>
              </div>
            <% end %>

            <div class="mt-auto flex items-center justify-between pt-6 text-sm">
              <span class="text-slate-500">Posted <%= l(job.created_at.to_date, format: :long) %></span>
              <%= link_to "View job", job_path(job), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <h2 class="text-xl font-semibold">No open jobs right now</h2>
      <p class="mt-2 text-slate-600">Check back soon for new opportunities.</p>
    </div>
  <% end %>
</section>
