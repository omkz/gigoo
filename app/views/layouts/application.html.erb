<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Gigoo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Gigoo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="container mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <%= link_to "Gigoo", jobs_path, class: "text-xl font-bold tracking-tight text-slate-900" %>
        <nav class="flex items-center gap-4 text-sm font-semibold">
          <%= link_to "Browse jobs", jobs_path, class: "text-slate-600 hover:text-indigo-600" %>
          <% if authenticated? %>
            <% if Current.user.client_profile.present? %>
              <%= link_to "My jobs", client_jobs_path, class: "text-slate-600 hover:text-indigo-600" %>
            <% end %>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-slate-600 hover:text-indigo-600" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "text-slate-600 hover:text-indigo-600" %>
          <% end %>
        </nav>
      </div>
    </header>
    <main class="container mx-auto max-w-6xl px-5 py-12">
      <% flash.each do |type, message| %>
        <div class="mb-6 rounded-lg border px-4 py-3 <%= type.to_s == "alert" ? "border-red-200 bg-red-50 text-red-800" : "border-emerald-200 bg-emerald-50 text-emerald-800" %>">
          <%= message %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
