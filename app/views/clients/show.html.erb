<% content_for :title, "#{@client.user.name} · Gigoo" %>

<section class="mx-auto w-full max-w-4xl">
  <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-sm text-slate-500">Client profile</p>
    <% if @client.company_name.present? %>
      <h1 class="mt-1 text-3xl font-bold tracking-tight"><%= @client.company_name %></h1>
      <p class="mt-2 font-semibold text-slate-700"><%= @client.user.name %></p>
    <% else %>
      <h1 class="mt-1 text-3xl font-bold tracking-tight"><%= @client.user.name %></h1>
    <% end %>

    <% if @client.location.present? %>
      <p class="mt-2 text-slate-600"><%= @client.location %></p>
    <% end %>
    <% if @client.bio.present? %>
      <div class="mt-6 whitespace-pre-wrap leading-7 text-slate-700"><%= @client.bio %></div>
    <% end %>
  </article>

  <section class="mt-8">
    <h2 class="text-2xl font-bold">Trust evidence</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-lg bg-white p-4 shadow-sm">
        <p class="font-semibold <%= @client.payment_verified? ? "text-emerald-700" : "text-slate-600" %>"><%= @client.payment_verified? ? "Payment verified" : "Payment not yet verified" %></p>
      </div>
      <div class="rounded-lg bg-white p-4 shadow-sm">
        <% if @review_count.positive? %>
          <p class="text-lg font-semibold"><%= number_with_precision(@average_rating, precision: 1) %> · <%= pluralize(@review_count, "review") %></p>
        <% else %>
          <p class="font-semibold text-slate-600">No reviews yet</p>
        <% end %>
      </div>
      <div class="rounded-lg bg-white p-4 shadow-sm">
        <% if @completed_contract_count.positive? %>
          <p class="text-lg font-semibold"><%= pluralize(@completed_contract_count, "completed contract") %></p>
        <% else %>
          <p class="font-semibold text-slate-600">No completed contracts yet</p>
        <% end %>
      </div>
      <div class="rounded-lg bg-white p-4 shadow-sm">
        <p class="text-lg font-semibold"><%= pluralize(@repeat_freelancer_count, "repeat freelancer") %></p>
      </div>
      <div class="rounded-lg bg-white p-4 shadow-sm">
        <p class="text-lg font-semibold"><%= pluralize(@low_rating_count, "low rating") %></p>
      </div>
    </div>

    <% if @review_count.positive? %>
      <h3 class="mt-8 text-xl font-semibold">Recent reviews</h3>
      <%= render "reviews/public_reviews", reviews: @reviews %>
    <% end %>
  </section>
</section>
