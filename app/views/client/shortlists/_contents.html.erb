<div id="job_<%= job.id %>_shortlist_contents">
  <% if shortlists.any? %>
    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <% shortlists.each do |shortlist| %>
        <% profile = shortlist.freelancer.freelancer_profile %>
        <% evidence = trust_evidence.fetch(shortlist.freelancer_id) %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-semibold"><%= shortlist.freelancer.name %></h2>
              <% if profile.title.present? %>
                <p class="mt-1 font-medium text-slate-700"><%= profile.title %></p>
              <% end %>
              <% if profile.location.present? %>
                <p class="mt-1 text-sm text-slate-500"><%= profile.location %></p>
              <% end %>
            </div>
            <% if profile.hourly_rate_cents.present? %>
              <p class="shrink-0 font-semibold"><%= number_to_currency(profile.hourly_rate_cents / 100.0) %>/hr</p>
            <% end %>
          </div>

          <% if profile.skills.any? %>
            <div class="mt-5 flex flex-wrap gap-2">
              <% profile.skills.each do |skill| %>
                <span class="rounded-md bg-indigo-50 px-2.5 py-1 text-sm text-indigo-700"><%= skill %></span>
              <% end %>
            </div>
          <% end %>

          <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-lg bg-slate-50 p-3">
              <% if evidence[:review_count].positive? %>
                <p class="font-semibold"><%= number_with_precision(evidence[:average_rating], precision: 1) %> · <%= pluralize(evidence[:review_count], "review") %></p>
              <% else %>
                <p class="font-semibold text-slate-600">No reviews yet</p>
              <% end %>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <% if evidence[:completed_contract_count].positive? %>
                <p class="font-semibold"><%= pluralize(evidence[:completed_contract_count], "completed contract") %></p>
              <% else %>
                <p class="font-semibold text-slate-600">No completed contracts yet</p>
              <% end %>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <p class="font-semibold"><%= pluralize(evidence[:repeat_client_count], "repeat client") %></p>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <p class="font-semibold"><%= pluralize(evidence[:low_rating_count], "low rating") %></p>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-between gap-4 border-t border-slate-200 pt-5">
            <%= link_to "View profile", freelancer_path(profile), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
            <%= button_to "Remove", client_job_shortlist_path(job, shortlist), method: :delete, class: "font-semibold text-red-600 hover:text-red-500" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <h2 class="text-xl font-semibold">No shortlisted freelancers yet.</h2>
      <p class="mt-2 text-slate-600">Browse the freelancer directory to find candidates for this job.</p>
    </div>
  <% end %>
</div>
