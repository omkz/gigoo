<% content_for :title, "Shortlist for #{@job.title} · Gigoo" %>

<section class="w-full">
  <%= link_to "← My jobs", client_jobs_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>

  <div class="mt-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-600">Client shortlist</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight"><%= @job.title %></h1>
    </div>
    <%= link_to "Find freelancers", freelancers_path, class: "rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-500" %>
  </div>

  <%= render "contents", job: @job, shortlists: @shortlists, trust_evidence: @trust_evidence %>
</section>
