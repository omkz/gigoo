<% content_for :title, "Contract for #{@contract.job.title} · Gigoo" %>

<section class="mx-auto w-full max-w-3xl">
  <div class="flex flex-wrap items-center gap-4">
    <%= link_to "← My Jobs", client_jobs_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
    <%= link_to "View proposal history", client_job_proposals_path(@contract.job), class: "text-sm font-semibold text-slate-500 hover:text-slate-700" %>
  </div>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-600">Contract</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight"><%= @contract.job.title %></h1>

    <dl class="mt-8 grid gap-6 border-y border-slate-200 py-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-slate-500">Freelancer</dt>
        <dd class="mt-1 text-lg font-semibold"><%= @contract.freelancer.name %></dd>
        <% if @contract.freelancer.freelancer_profile&.title.present? %>
          <dd class="mt-1 text-sm text-slate-600"><%= @contract.freelancer.freelancer_profile.title %></dd>
        <% end %>
      </div>
      <div>
        <dt class="text-sm text-slate-500">Agreed amount</dt>
        <dd class="mt-1 text-lg font-semibold"><%= number_to_currency(@contract.amount_cents / 100.0) %></dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500">Status</dt>
        <dd class="mt-1 font-semibold"><%= @contract.status.humanize %></dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500">Started</dt>
        <dd class="mt-1 font-semibold"><%= @contract.started_at.present? ? l(@contract.started_at, format: :long) : "Not started" %></dd>
      </div>
      <% if @contract.completed_at.present? %>
        <div>
          <dt class="text-sm text-slate-500">Completed</dt>
          <dd class="mt-1 font-semibold"><%= l(@contract.completed_at, format: :long) %></dd>
        </div>
      <% end %>
    </dl>

    <% if @contract.active? %>
      <%= button_to "Mark contract complete", complete_client_contract_path(@contract), method: :patch, class: "mt-6 rounded-lg bg-emerald-600 px-5 py-3 font-semibold text-white hover:bg-emerald-500" %>
    <% elsif @contract.completed? %>
      <p class="mt-6 font-semibold text-emerald-700">Completed</p>
    <% end %>
  </div>

  <% if @contract.completed? %>
    <%= render "reviews/form_or_review", contract: @contract, review: @review, title: "Rate freelancer" %>
  <% end %>
</section>
