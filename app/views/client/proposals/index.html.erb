<% content_for :title, "Proposals for #{@job.title} · Gigoo" %>

<section class="w-full">
  <%= link_to "← My jobs", client_jobs_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Received proposals</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight"><%= @job.title %></h1>
      </div>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-slate-700"><%= @job.status %></span>
    </div>

    <p class="mt-5 font-semibold text-slate-800"><%= number_to_currency(@job.budget) %> budget</p>
    <% if @job.skills.any? %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% @job.skills.each do |skill| %>
          <span class="rounded-md bg-indigo-50 px-2.5 py-1 text-sm text-indigo-700"><%= skill %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @proposals.any? %>
    <div class="mt-8 space-y-5">
      <% @proposals.each do |proposal| %>
        <% profile = proposal.freelancer.freelancer_profile %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
            <div>
              <h2 class="text-xl font-semibold"><%= proposal.freelancer.name %></h2>
              <% if profile&.title.present? %>
                <p class="mt-1 font-medium text-slate-700"><%= profile.title %></p>
              <% end %>
              <% if profile&.location.present? %>
                <p class="mt-1 text-sm text-slate-600"><%= profile.location %></p>
              <% end %>
            </div>
            <div class="text-left sm:text-right">
              <p class="text-xl font-semibold"><%= number_to_currency(proposal.amount) %></p>
              <span class="mt-2 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-slate-700"><%= proposal.status %></span>
            </div>
          </div>

          <% if profile&.skills&.any? %>
            <div class="mt-5 flex flex-wrap gap-2">
              <% profile.skills.each do |skill| %>
                <span class="rounded-md bg-emerald-50 px-2.5 py-1 text-sm text-emerald-700"><%= skill %></span>
              <% end %>
            </div>
          <% end %>

          <% if profile&.hourly_rate_cents.present? || profile&.bio.present? %>
            <div class="mt-5 text-sm text-slate-600">
              <% if profile.hourly_rate_cents.present? %>
                <p><span class="font-semibold text-slate-700">Hourly rate:</span> <%= number_to_currency(profile.hourly_rate_cents / 100.0) %></p>
              <% end %>
              <% if profile.bio.present? %>
                <p class="mt-2"><%= profile.bio %></p>
              <% end %>
            </div>
          <% end %>

          <div class="mt-6 border-t border-slate-200 pt-5">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Proposal message</h3>
            <div class="mt-2 whitespace-pre-wrap leading-7 text-slate-700"><%= proposal.message %></div>
            <p class="mt-4 text-sm text-slate-500">Submitted <%= l(proposal.created_at.to_date, format: :long) %></p>

            <% if @job.open? && @job.contract.blank? && proposal.pending? %>
              <%= button_to "Accept proposal", accept_client_job_proposal_path(@job, proposal), method: :patch, class: "mt-5 rounded-lg bg-emerald-600 px-4 py-2.5 font-semibold text-white hover:bg-emerald-500" %>
            <% elsif proposal.accepted? && @job.contract.present? %>
              <div class="mt-5 flex flex-wrap items-center gap-4">
                <span class="font-semibold text-emerald-700">Contract <%= @job.contract.status %></span>
                <%= link_to "View contract", client_contract_path(@job.contract), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <h2 class="text-xl font-semibold">No proposals yet.</h2>
      <p class="mt-2 text-slate-600">Proposals will appear here when freelancers apply.</p>
    </div>
  <% end %>
</section>
