<%= form_with model: [ :client, job ], class: "space-y-6" do |form| %>
  <% if job.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-semibold"><%= pluralize(job.errors.count, "error") %> prevented this job from being saved:</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% job.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-semibold text-slate-700" %>
    <%= form.text_field :title, required: true, autofocus: true, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-semibold text-slate-700" %>
    <%= form.text_area :description, required: true, rows: 8, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
  </div>

  <div>
    <%= form.label :budget, "Budget", class: "block text-sm font-semibold text-slate-700" %>
    <%= form.number_field :budget, required: true, min: 0, step: 0.01, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    <p class="mt-1 text-sm text-slate-500">Enter the total budget in currency units.</p>
  </div>

  <div>
    <%= form.label :skills, class: "block text-sm font-semibold text-slate-700" %>
    <%= form.text_field :skills, value: job.skills.join(", "), placeholder: "Ruby, Rails, PostgreSQL", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    <p class="mt-1 text-sm text-slate-500">Separate skills with commas.</p>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <%= link_to "Cancel", client_jobs_path, class: "rounded-lg px-4 py-3 font-semibold text-slate-600 hover:bg-slate-100" %>
  </div>
<% end %>
