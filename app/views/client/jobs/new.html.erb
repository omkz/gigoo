<% content_for :title, "Post a Job · Gigoo" %>

<section class="mx-auto w-full max-w-3xl">
  <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">New listing</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight">Post a Job</h1>
  <p class="mt-2 text-slate-600">Your new job will be saved as a draft.</p>

  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "form", job: @job %>
  </div>
</section>
