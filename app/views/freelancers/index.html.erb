<% content_for :title, "Find Freelancers · Gigoo" %>

<section class="w-full">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Talent directory</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight">Find freelancers</h1>
    <p class="mt-2 text-slate-600">Browse independent professionals by experience, location, and skills.</p>
  </div>

  <%= form_with url: freelancers_path, method: :get, class: "mb-8 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-[1fr_1fr_auto]" do |form| %>
    <div>
      <%= form.label :q, "Search", class: "block text-sm font-semibold text-slate-700" %>
      <%= form.search_field :q, value: params[:q], placeholder: "Title, bio, or location", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    </div>
    <div>
      <%= form.label :skill, class: "block text-sm font-semibold text-slate-700" %>
      <%= form.search_field :skill, value: params[:skill], placeholder: "Ruby", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    </div>
    <div class="flex items-end gap-3">
      <%= form.submit "Filter", class: "rounded-lg bg-indigo-600 px-5 py-2.5 font-semibold text-white hover:bg-indigo-500" %>
      <% if params[:q].present? || params[:skill].present? %>
        <%= link_to "Clear", freelancers_path, class: "rounded-lg px-3 py-2.5 font-semibold text-slate-600 hover:bg-slate-100" %>
      <% end %>
    </div>
  <% end %>

  <% if @freelancers.any? %>
    <div class="grid gap-5 lg:grid-cols-2">
      <% @freelancers.each do |freelancer| %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-semibold">
                <%= link_to freelancer.user.name, freelancer_path(freelancer), class: "hover:text-indigo-600" %>
              </h2>
              <% if freelancer.title.present? %>
                <p class="mt-1 font-medium text-slate-700"><%= freelancer.title %></p>
              <% end %>
              <% if freelancer.location.present? %>
                <p class="mt-1 text-sm text-slate-500"><%= freelancer.location %></p>
              <% end %>
            </div>
            <% if freelancer.hourly_rate_cents.present? %>
              <p class="shrink-0 font-semibold"><%= number_to_currency(freelancer.hourly_rate_cents / 100.0) %>/hr</p>
            <% end %>
          </div>

          <% if freelancer.bio.present? %>
            <p class="mt-4 text-slate-600"><%= truncate(strip_tags(freelancer.bio), length: 150) %></p>
          <% end %>

          <% if freelancer.skills.any? %>
            <div class="mt-5 flex flex-wrap gap-2">
              <% freelancer.skills.each do |skill| %>
                <span class="rounded-md bg-indigo-50 px-2.5 py-1 text-sm text-indigo-700"><%= skill %></span>
              <% end %>
            </div>
          <% end %>

          <%= link_to "View profile", freelancer_path(freelancer), class: "mt-6 inline-flex font-semibold text-indigo-600 hover:text-indigo-500" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <h2 class="text-xl font-semibold">No freelancers found</h2>
      <p class="mt-2 text-slate-600">Try a broader search or a different skill.</p>
    </div>
  <% end %>
</section>
