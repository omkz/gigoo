<% content_for :title, "#{@freelancer.user.name} · Gigoo" %>

<div class="grid w-full gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= link_to "← Find freelancers", freelancers_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>

    <div class="mt-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
      <div>
        <p class="text-sm text-slate-500">Freelancer profile</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight"><%= @freelancer.user.name %></h1>
        <% if @freelancer.title.present? %>
          <p class="mt-2 font-semibold text-slate-700"><%= @freelancer.title %></p>
        <% end %>
        <% if @freelancer.location.present? %>
          <p class="mt-2 text-slate-600"><%= @freelancer.location %></p>
        <% end %>
      </div>
      <% if @freelancer.hourly_rate_cents.present? %>
        <p class="text-xl font-semibold"><%= number_to_currency(@freelancer.hourly_rate_cents / 100.0) %>/hr</p>
      <% end %>
    </div>

    <% if @freelancer.bio.present? %>
      <div class="mt-8 whitespace-pre-wrap leading-7 text-slate-700"><%= @freelancer.bio %></div>
    <% end %>

    <% if @freelancer.skills.any? %>
      <div class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Skills</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          <% @freelancer.skills.each do |skill| %>
            <span class="rounded-md bg-indigo-50 px-3 py-1.5 text-sm text-indigo-700"><%= skill %></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <section class="mt-8 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold">Trust evidence</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg bg-slate-50 p-4">
          <% if @review_count.positive? %>
            <p class="text-lg font-semibold"><%= number_with_precision(@average_rating, precision: 1) %> · <%= pluralize(@review_count, "review") %></p>
          <% else %>
            <p class="font-semibold text-slate-600">No reviews yet</p>
          <% end %>
        </div>
        <div class="rounded-lg bg-slate-50 p-4">
          <% if @completed_contract_count.positive? %>
            <p class="text-lg font-semibold"><%= pluralize(@completed_contract_count, "completed contract") %></p>
          <% else %>
            <p class="font-semibold text-slate-600">No completed contracts yet</p>
          <% end %>
        </div>
        <div class="rounded-lg bg-slate-50 p-4">
          <p class="text-lg font-semibold"><%= pluralize(@repeat_client_count, "repeat client") %></p>
        </div>
        <div class="rounded-lg bg-slate-50 p-4">
          <p class="text-lg font-semibold"><%= pluralize(@low_rating_count, "low rating") %></p>
        </div>
      </div>

      <% if @review_count.positive? %>
        <h3 class="mt-8 text-xl font-semibold">Recent reviews</h3>
        <%= render "reviews/public_reviews", reviews: @reviews %>
      <% end %>
    </section>
  </article>

  <% if Current.user == @freelancer.user && @latest_contract.present? %>
    <aside>
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold">Your latest contract</h2>
        <p class="mt-3 font-medium"><%= @latest_contract.job.title %></p>
        <%= link_to "View contract", freelancer_contract_path(@latest_contract), class: "mt-5 inline-flex font-semibold text-indigo-600 hover:text-indigo-500" %>
      </div>
    </aside>
  <% elsif Current.user&.client_profile %>
    <aside>
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold">Add to a shortlist</h2>

        <% if Current.user == @freelancer.user %>
          <p class="mt-3 text-slate-600">You cannot shortlist yourself.</p>
        <% elsif @client_jobs.any? %>
          <div class="mt-5 space-y-3">
            <% @client_jobs.each do |job| %>
              <div class="rounded-lg border border-slate-200 p-4">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold"><%= job.title %></p>
                    <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= job.status %></p>
                  </div>
                  <% if @shortlisted_job_ids.include?(job.id) %>
                    <span class="text-sm font-semibold text-emerald-700">Shortlisted</span>
                  <% else %>
                    <%= button_to "Add", client_job_shortlists_path(job), params: { freelancer_profile_id: @freelancer.id }, class: "rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-slate-600">Create a draft or open job before shortlisting freelancers.</p>
        <% end %>
      </div>
    </aside>
  <% end %>
</div>
