<% content_for :title, "Review proposal draft · Gigoo" %>

<section class="mx-auto w-full max-w-2xl">
  <%= link_to "← Back to job", job_path(@proposal.job), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-amber-600">Draft · Not submitted</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight">Review your proposal</h1>
    <%= link_to @proposal.job.title, job_path(@proposal.job), class: "mt-3 block text-slate-600 hover:text-indigo-600 hover:underline" %>

    <%= form_with model: [ :freelancer, @proposal ], class: "mt-8 space-y-5" do |form| %>
      <% if @proposal.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
          <ul class="list-disc space-y-1 pl-5 text-sm">
            <% @proposal.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :amount, "Proposed amount", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.number_field :amount, required: true, min: 0.01, step: 0.01, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>

      <div>
        <%= form.label :message, "Cover letter", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :message, required: true, rows: 8, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>

      <%= form.submit "Save draft", class: "rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white hover:bg-indigo-500" %>
    <% end %>

    <div class="mt-8 border-t border-slate-200 pt-6">
      <p class="text-sm text-slate-600">Submitting sends this proposal to the client. You will no longer be able to edit it as a draft.</p>
      <%= button_to "Submit proposal",
        submit_freelancer_proposal_path(@proposal),
        method: :patch,
        class: "mt-4 rounded-lg bg-emerald-600 px-4 py-3 font-semibold text-white hover:bg-emerald-500" %>
    </div>
  </div>
</section>
