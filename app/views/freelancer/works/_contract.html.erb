<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <h3 class="text-lg font-semibold"><%= contract.job.title %></h3>
      <% if contract.client.client_profile&.company_name.present? %>
        <p class="mt-1 text-sm text-slate-600"><%= contract.client.client_profile.company_name %> · <%= contract.client.name %></p>
      <% else %>
        <p class="mt-1 text-sm text-slate-600"><%= contract.client.name %></p>
      <% end %>
    </div>
    <div class="sm:text-right">
      <p class="font-semibold"><%= number_to_currency(contract.amount_cents / 100.0) %></p>
      <span class="mt-1 inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-700"><%= contract.status.humanize %></span>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-4 text-sm">
    <% if contract.completed? %>
      <span class="text-slate-500"><%= contract.completed_at.present? ? "Completed #{l(contract.completed_at.to_date, format: :long)}" : "Completed" %></span>
    <% else %>
      <span class="text-slate-500"><%= contract.started_at.present? ? "Started #{l(contract.started_at.to_date, format: :long)}" : "Start date not set" %></span>
    <% end %>
    <%= link_to "View contract", freelancer_contract_path(contract), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
  </div>
</article>
