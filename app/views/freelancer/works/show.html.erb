<% content_for :title, "My Work · Gigoo" %>

<section class="mx-auto w-full max-w-5xl">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Freelancer workspace</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight">My Work</h1>
    <p class="mt-2 text-slate-600">Track your proposals and freelance contracts.</p>
  </div>

  <% if @active_contracts.empty? && @proposals.empty? && @completed_contracts.empty? %>
    <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
      <h2 class="text-xl font-semibold">Your freelance work will appear here.</h2>
      <%= link_to "Browse jobs", jobs_path, class: "mt-4 inline-flex rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-500" %>
    </div>
  <% else %>
    <section class="mt-10">
      <h2 class="text-2xl font-bold">Active contracts</h2>
      <% if @active_contracts.any? %>
        <div class="mt-5 space-y-4">
          <%= render partial: "contract", collection: @active_contracts %>
        </div>
      <% else %>
        <p class="mt-4 rounded-lg bg-white p-4 text-sm text-slate-600 shadow-sm">No active contracts.</p>
      <% end %>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">Proposals</h2>
      <% if @proposals.any? %>
        <div class="mt-5 space-y-4">
          <% @proposals.each do |proposal| %>
            <% job = proposal.job %>
            <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
                <div>
                  <h3 class="text-lg font-semibold">
                    <% if job.open? %>
                      <%= link_to job.title, job_path(job), class: "hover:text-indigo-600" %>
                    <% else %>
                      <%= job.title %>
                    <% end %>
                  </h3>
                  <% if job.client.client_profile&.company_name.present? %>
                    <p class="mt-1 text-sm text-slate-600"><%= job.client.client_profile.company_name %> · <%= job.client.name %></p>
                  <% else %>
                    <p class="mt-1 text-sm text-slate-600"><%= job.client.name %></p>
                  <% end %>
                </div>
                <div class="sm:text-right">
                  <p class="font-semibold"><%= number_to_currency(proposal.amount) %></p>
                  <% if proposal.draft? %>
                    <span class="mt-1 inline-flex rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-700">Draft · Not submitted</span>
                  <% else %>
                    <span class="mt-1 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-slate-700"><%= proposal.status.humanize %></span>
                  <% end %>
                </div>
              </div>

              <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-4 text-sm">
                <span class="text-slate-500"><%= proposal.draft? ? "Created" : "Submitted" %> <%= l(proposal.created_at.to_date, format: :long) %></span>
                <% if proposal.draft? && job.open? %>
                  <%= link_to "Review and edit", edit_freelancer_proposal_path(proposal), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
                <% elsif proposal.accepted? && job.contract&.freelancer == Current.user %>
                  <%= link_to "View contract", freelancer_contract_path(job.contract), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 rounded-lg bg-white p-4 text-sm text-slate-600 shadow-sm">No proposals yet.</p>
      <% end %>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">Completed contracts</h2>
      <% if @completed_contracts.any? %>
        <div class="mt-5 space-y-4">
          <%= render partial: "contract", collection: @completed_contracts %>
        </div>
      <% else %>
        <p class="mt-4 rounded-lg bg-white p-4 text-sm text-slate-600 shadow-sm">No completed contracts.</p>
      <% end %>
    </section>
  <% end %>
</section>
