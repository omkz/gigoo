<% content_for :title, "Profile · Gigoo" %>

<section class="mx-auto w-full max-w-4xl">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Your Gigoo account</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight">Profile</h1>
    <p class="mt-2 text-slate-600">Manage your freelancer and client presence from one account.</p>
  </div>

  <article class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Account</p>

    <dl class="mt-5 space-y-4 text-sm">
      <div>
        <dt class="font-semibold text-slate-500">Name</dt>
        <dd class="mt-1 text-slate-800"><%= @user.name %></dd>
      </div>
      <div>
        <dt class="font-semibold text-slate-500">Email</dt>
        <dd class="mt-1 text-slate-800"><%= @user.email_address %></dd>
      </div>
    </dl>

    <div class="mt-6 border-t border-slate-200 pt-5">
      <%= link_to "Edit account", edit_profile_account_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
    </div>
  </article>

  <div class="mt-8 grid gap-6 <%= "lg:grid-cols-2" if @freelancer_profile && @client_profile %>">
    <% if @freelancer_profile %>
      <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Freelancer</p>
        <h2 class="mt-1 text-2xl font-semibold"><%= @freelancer_profile.title.presence || "Title not set" %></h2>

        <dl class="mt-5 space-y-4 text-sm">
          <div>
            <dt class="font-semibold text-slate-500">Location</dt>
            <dd class="mt-1 text-slate-800"><%= @freelancer_profile.location.presence || "Not set" %></dd>
          </div>
          <div>
            <dt class="font-semibold text-slate-500">Hourly rate</dt>
            <dd class="mt-1 text-slate-800"><%= @freelancer_profile.hourly_rate_cents.present? ? "#{number_to_currency(@freelancer_profile.hourly_rate)} USD/hour" : "Not set" %></dd>
          </div>
          <div>
            <dt class="font-semibold text-slate-500">Skills</dt>
            <dd class="mt-1 text-slate-800"><%= @freelancer_profile.skills.any? ? @freelancer_profile.skills.join(", ") : "Not set" %></dd>
          </div>
          <div>
            <dt class="font-semibold text-slate-500">Bio</dt>
            <dd class="mt-1 whitespace-pre-wrap text-slate-800"><%= @freelancer_profile.bio.presence || "Not set" %></dd>
          </div>
        </dl>

        <div class="mt-6 flex flex-wrap gap-4 border-t border-slate-200 pt-5">
          <%= link_to "Edit freelancer profile", edit_profile_freelancer_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
          <%= link_to "View public profile", freelancer_path(@freelancer_profile), class: "font-semibold text-slate-600 hover:text-slate-900" %>
        </div>
      </article>
    <% end %>

    <% if @client_profile %>
      <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-wide text-emerald-600">Client</p>
        <h2 class="mt-1 text-2xl font-semibold"><%= @client_profile.company_name.presence || "Company name not set" %></h2>

        <dl class="mt-5 space-y-4 text-sm">
          <div>
            <dt class="font-semibold text-slate-500">Location</dt>
            <dd class="mt-1 text-slate-800"><%= @client_profile.location.presence || "Not set" %></dd>
          </div>
          <div>
            <dt class="font-semibold text-slate-500">Payment status</dt>
            <dd class="mt-1 font-semibold <%= @client_profile.payment_verified? ? "text-emerald-700" : "text-slate-600" %>"><%= @client_profile.payment_verified? ? "Payment verified" : "Payment not yet verified" %></dd>
          </div>
          <div>
            <dt class="font-semibold text-slate-500">Bio</dt>
            <dd class="mt-1 whitespace-pre-wrap text-slate-800"><%= @client_profile.bio.presence || "Not set" %></dd>
          </div>
        </dl>

        <div class="mt-6 flex flex-wrap gap-4 border-t border-slate-200 pt-5">
          <%= link_to "Edit client profile", edit_profile_client_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
          <%= link_to "View public profile", client_path(@client_profile), class: "font-semibold text-slate-600 hover:text-slate-900" %>
        </div>
      </article>
    <% end %>
  </div>

  <% if @freelancer_profile && !@client_profile %>
    <p class="mt-8 text-sm text-slate-600">Want to post jobs too? <%= link_to "Start hiring", onboarding_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %></p>
  <% elsif @client_profile && !@freelancer_profile %>
    <p class="mt-8 text-sm text-slate-600">Want to find projects too? <%= link_to "Start freelancing", onboarding_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %></p>
  <% elsif !@freelancer_profile && !@client_profile %>
    <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="text-slate-600">Choose how you want to participate in the marketplace.</p>
      <%= link_to "Choose a capability", onboarding_path, class: "mt-4 inline-flex font-semibold text-indigo-600 hover:text-indigo-500" %>
    </div>
  <% end %>
</section>
