<% content_for :title, "Edit account · Gigoo" %>

<section class="mx-auto w-full max-w-2xl">
  <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Account</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight">Edit account</h1>

  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= form_with model: @user, scope: :user, url: profile_account_path, class: "space-y-6" do |form| %>
      <% if @user.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
          <h2 class="font-semibold"><%= pluralize(@user.errors.count, "error") %> prevented this account from being saved:</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :first_name, "First name", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :first_name, autofocus: true, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>

      <div>
        <%= form.label :last_name, "Last name", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :last_name, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>

      <div>
        <span class="block text-sm font-semibold text-slate-700">Email address</span>
        <p class="mt-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-slate-700"><%= @user.email_address %></p>
        <p class="mt-1 text-sm text-slate-500">Email changes are not supported from this form.</p>
      </div>

      <div class="flex items-center gap-3">
        <%= form.submit "Save changes", class: "rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-500" %>
        <%= link_to "Cancel", profile_path, class: "rounded-lg px-4 py-3 font-semibold text-slate-600 hover:bg-slate-100" %>
      </div>
    <% end %>
  </div>
</section>
