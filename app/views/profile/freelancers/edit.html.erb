<% content_for :title, "Edit freelancer profile · Gigoo" %>

<section class="mx-auto w-full max-w-2xl">
  <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Freelancer profile</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight">Edit freelancer profile</h1>

  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= form_with model: @freelancer_profile, scope: :freelancer_profile, url: profile_freelancer_path, class: "space-y-6" do |form| %>
      <% if @freelancer_profile.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
          <h2 class="font-semibold"><%= pluralize(@freelancer_profile.errors.count, "error") %> prevented this profile from being saved:</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
            <% @freelancer_profile.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :title, class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :title, autofocus: true, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>

      <div>
        <%= form.label :location, class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :location, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>

      <div>
        <%= form.label :hourly_rate, "Hourly rate (USD)", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.number_field :hourly_rate, min: 0, step: 0.01, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>

      <div>
        <%= form.label :skills, class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :skills, value: @freelancer_profile.skills.join(", "), placeholder: "Ruby, Rails, PostgreSQL", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
        <p class="mt-1 text-sm text-slate-500">Separate skills with commas.</p>
      </div>

      <div>
        <%= form.label :bio, class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :bio, rows: 7, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>

      <div class="flex items-center gap-3">
        <%= form.submit "Save changes", class: "rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-500" %>
        <%= link_to "Cancel", profile_path, class: "rounded-lg px-4 py-3 font-semibold text-slate-600 hover:bg-slate-100" %>
      </div>
    <% end %>
  </div>
</section>
