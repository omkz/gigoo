<div class="mt-5 space-y-4">
  <% reviews.each do |review| %>
    <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-lg text-amber-500" aria-label="<%= review.rating %> out of 5 stars"><%= "★" * review.rating %></p>
      <% if review.body.present? %>
        <div class="mt-3 whitespace-pre-wrap text-slate-700"><%= review.body %></div>
      <% end %>
      <p class="mt-4 text-sm font-semibold text-slate-700">— <%= review.reviewer.name %></p>
      <% if review.reviewer.client_profile&.company_name.present? %>
        <p class="mt-1 text-sm text-slate-500"><%= review.reviewer.client_profile.company_name %></p>
      <% elsif review.reviewer.freelancer_profile&.title.present? %>
        <p class="mt-1 text-sm text-slate-500"><%= review.reviewer.freelancer_profile.title %></p>
      <% end %>
    </article>
  <% end %>
</div>
