<section class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-xl font-semibold"><%= title %></h2>

  <% if review.persisted? %>
    <p class="mt-4 text-xl text-amber-500" aria-label="<%= review.rating %> out of 5 stars"><%= "★" * review.rating %></p>
    <% if review.body.present? %>
      <div class="mt-3 whitespace-pre-wrap text-slate-700"><%= review.body %></div>
    <% end %>
  <% else %>
    <%= form_with model: [ contract, review ], class: "mt-5 space-y-5" do |form| %>
      <div>
        <%= form.label :rating, "Rating", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.select :rating, options_for_select((1..5).map { |rating| [ "#{rating} / 5", rating ] }, review.rating), { prompt: "Choose a rating" }, required: true, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm" %>
      </div>
      <div>
        <%= form.label :body, "Review", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :body, rows: 5, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm", placeholder: "Describe your experience working together." %>
      </div>
      <%= form.submit "Submit review", class: "cursor-pointer rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-500" %>
    <% end %>
  <% end %>
</section>
