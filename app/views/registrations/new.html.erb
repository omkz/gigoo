<% content_for :title, "Create an account · Gigoo" %>

<section class="mx-auto w-full max-w-xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Join Gigoo</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight">Create an account</h1>
  <p class="mt-2 text-slate-600">Start as a member. You can add client or freelancer capabilities later.</p>

  <% if @user.errors.any? %>
    <div class="mt-6 rounded-lg bg-red-50 p-4 text-red-700">
      <h2 class="font-semibold"><%= pluralize(@user.errors.count, "error") %> prevented this account from being created:</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: sign_up_path, class: "mt-6 space-y-5" do |form| %>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :first_name, "First name", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :first_name, required: true, autofocus: true, autocomplete: "given-name", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>
      <div>
        <%= form.label :last_name, "Last name", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
      </div>
    </div>

    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm font-semibold text-slate-700" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-semibold text-slate-700" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-semibold text-slate-700" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    </div>

    <%= form.submit "Create account", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-500" %>
  <% end %>

  <p class="mt-6 text-center text-sm text-slate-600">
    Already have an account?
    <%= link_to "Sign in", new_session_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
  </p>
</section>
